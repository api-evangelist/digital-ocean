            }
          },
          "docs": "To update the settings of an Uptime alert, send a PUT request to `/v2/uptime/checks/$CHECK_ID/alerts/$ALERT_ID`.\n"
        },
        {
          "info": {
            "name": "Delete an Alert",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.digitalocean.com/v2/uptime/checks/:check_id/alerts/:alert_id",
            "params": [
              {
                "name": "check_id",
                "value": "4de7ac8b-495b-4884-9a69-1050c6793cd6",
                "type": "path",
                "description": "A unique identifier for a check."
              },
              {
                "name": "alert_id",
                "value": "17f0f0ae-b7e5-4ef6-86e3-aa569db58284",
                "type": "path",
                "description": "A unique identifier for an alert."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "To delete an Uptime alert, send a DELETE request to `/v2/uptime/checks/$CHECK_ID/alerts/$ALERT_ID`. A 204 status\ncode with no body will be returned in response to a successful request.\n"
        }
      ]
    }
  ],
  "bundled": true
}