            }
          },
          "docs": "To show information about an existing alert, send a GET request to `/v2/uptime/checks/$CHECK_ID/alerts/$ALERT_ID`."
        },
        {
          "info": {
            "name": "Update an Alert",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.digitalocean.com/v2/uptime/checks/:check_id/alerts/:alert_id",
            "params": [
              {
                "name": "check_id",
                "value": "4de7ac8b-495b-4884-9a69-1050c6793cd6",
                "type": "path",
                "description": "A unique identifier for a check."
              },
              {
                "name": "alert_id",
                "value": "17f0f0ae-b7e5-4ef6-86e3-aa569db58284",
