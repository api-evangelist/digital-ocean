{
  "opencollection": "1.0.0",
  "info": {
    "name": "DigitalOcean Account API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get User Information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.digitalocean.com/v2/account",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "To show information about the current user account, send a GET request to `/v2/account`."
        }
      ]
    }
  ],
  "bundled": true
}